# =================================================================
# MedChem ELN - Cấu hình Biến Môi Trường (Firebase Dual-Mode)
# =================================================================
# Lưu ý: Nếu để trống các biến dưới đây, ứng dụng sẽ TỰ ĐỘNG hoạt động 
# hoàn hảo ở chế độ Offline / LocalStorage mà không phát sinh bất kỳ lỗi nào.
# 
# Khi muốn đồng bộ trực tuyến đa thiết bị (Realtime Database & Cloud Storage):
# Điền thông tin dự án Firebase của bạn và đổi tên file thành `.env`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
